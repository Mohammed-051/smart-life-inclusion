{
  "rules": {
    ".read": false,
    ".write": false,

    "students": {
      "$studentId": {
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin' || root.child('devices/' + auth.uid + '/studentId').val() === $studentId)",
        ".write": "auth != null && root.child('supervisors/' + auth.uid + '/role').val() === 'admin'"
      }
    },

    "devices": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('supervisors/' + auth.uid + '/role').val() === 'admin'"
      }
    },

    "supervisors": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && root.child('supervisors/' + auth.uid + '/role').val() === 'admin'"
      }
    },

    "routes": {
      ".read": "auth != null && (root.child('devices/' + auth.uid).exists() || root.child('supervisors/' + auth.uid).exists())",
      "$routeId": {
        ".write": "auth != null && (root.child('supervisors/' + auth.uid + '/role').val() === 'admin' || (newData.exists() && root.child('supervisors/' + auth.uid + '/role').exists()))",
        ".validate": "newData.hasChildren(['name', 'kind', 'checkpoints'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "kind": { ".validate": "newData.val().matches(/^(adl|nav)$/)" },
        "version": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "checkpoints": {
          "$checkpointId": {
            ".validate": "newData.hasChildren(['order', 'markerId', 'label', 'cue'])",
            "order": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "markerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "label": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "cue": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "enabled": { ".validate": "newData.isBoolean()" },
            "prompt": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "holdSeconds": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "aacBoardId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "sessions": {
      "$studentId": {
        ".indexOn": ["startedAt", "status"],
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin' || root.child('devices/' + auth.uid + '/studentId').val() === $studentId)",
        "$sessionId": {
          ".write": "auth != null && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
          ".validate": "newData.hasChildren(['routeId', 'startedAt', 'status'])",
          "routeId": { ".validate": "newData.isString()" },
          "startedAt": { ".validate": "newData.isNumber()" },
          "completedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "status": { ".validate": "newData.val().matches(/^(active|completed|aborted)$/)" },
          "checkpointsReached": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "autonomousCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "activeDurationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "hesitationTotalMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "wrongScanCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        }
      }
    },

    "checkpointLogs": {
      "$studentId": {
        ".indexOn": ["timestamp"],
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        "$logId": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
          ".validate": "newData.hasChildren(['studentId', 'sessionId', 'routeId', 'checkpointId', 'markerId', 'taskStatus', 'autonomous', 'deviceId', 'timestamp'])",
          "studentId": { ".validate": "newData.val() === $studentId" },
          "sessionId": { ".validate": "newData.isString()" },
          "routeId": { ".validate": "newData.isString()" },
          "checkpointId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "markerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "taskStatus": { ".validate": "newData.val().matches(/^(started|completed|skipped|reset|paused|resumed)$/)" },
          "autonomous": { ".validate": "newData.isBoolean()" },
          "deviceId": { ".validate": "newData.val() === auth.uid" },
          "timestamp": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "nodeMetrics": {
      "$studentId": {
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        "$sessionId": {
          ".indexOn": ["timestamp"],
          "$metricId": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
            ".validate": "newData.hasChildren(['checkpointId', 'stepIndex', 'hesitationMs', 'holdMs', 'wrongScans', 'aacOpened', 'outcome', 'autonomous', 'timestamp'])",
            "checkpointId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "stepIndex": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "hesitationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "holdMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "wrongScans": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "aacOpened": { ".validate": "newData.isBoolean()" },
            "aacSelection": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "outcome": { ".validate": "newData.val().matches(/^(completed|skipped|reset)$/)" },
            "autonomous": { ".validate": "newData.isBoolean()" },
            "timestamp": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "emergencies": {
      "$studentId": {
        ".indexOn": ["status", "timestamp"],
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin' || root.child('devices/' + auth.uid + '/studentId').val() === $studentId)",
        "$emergencyId": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId && newData.child('status').val() === 'open'",
          ".validate": "newData.hasChildren(['source', 'status', 'timestamp'])",
          "source": { ".validate": "newData.val().matches(/^(audio|imu|sos)$/)" },
          "status": {
            ".write": "auth != null && data.exists() && newData.exists() && (root.child('devices/' + auth.uid + '/studentId').val() === $studentId || root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true)",
            ".validate": "newData.val().matches(/^(open|acknowledged|resolved)$/)"
          },
          "acknowledgedBy": {
            ".write": "auth != null && newData.exists() && root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true",
            ".validate": "newData.val() === auth.uid"
          },
          "sessionId": { ".validate": "newData.isString()" },
          "timestamp": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "interventions": {
      "$studentId": {
        ".indexOn": ["status"],
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin' || root.child('devices/' + auth.uid + '/studentId').val() === $studentId)",
        "$interventionId": {
          ".write": "auth != null && !data.exists() && newData.exists() && root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true && newData.child('requestedBy').val() === auth.uid && newData.child('status').val() === 'requested' && root.child('students/' + $studentId + '/streamingConsent').val() === true && root.child('emergencies/' + $studentId + '/' + newData.child('emergencyId').val() + '/source').val() === 'sos' && root.child('emergencies/' + $studentId + '/' + newData.child('emergencyId').val() + '/status').val() !== 'resolved' && root.child('emergencies/' + $studentId + '/' + newData.child('emergencyId').val()).exists()",
          ".validate": "newData.hasChildren(['emergencyId', 'requestedBy', 'status', 'offer', 'startedAt', 'expiresAt'])",
          "emergencyId": { ".validate": "newData.isString()" },
          "requestedBy": { ".validate": "newData.isString()" },
          "offer": { ".validate": "newData.isString() && newData.val().length <= 20000" },
          "startedAt": { ".validate": "newData.val() === now" },
          "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "status": {
            ".write": "auth != null && data.exists() && newData.exists() && (root.child('devices/' + auth.uid + '/studentId').val() === $studentId || root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true)",
            ".validate": "newData.val().matches(/^(requested|connected|ended|expired)$/)"
          },
          "endedAt": {
            ".write": "auth != null && newData.exists() && (root.child('devices/' + auth.uid + '/studentId').val() === $studentId || root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true)",
            ".validate": "newData.val() === now"
          },
          "answer": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "candidates": {
            "tablet": {
              "$candidateId": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
                ".validate": "newData.isString() && newData.val().length <= 1024"
              }
            },
            "supervisor": {
              "$candidateId": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true",
                ".validate": "newData.isString() && newData.val().length <= 1024"
              }
            },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "liveStatus": {
      "$studentId": {
        ".read": "auth != null && (root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        ".write": "auth != null && newData.exists() && root.child('devices/' + auth.uid + '/studentId').val() === $studentId",
        ".validate": "newData.hasChildren(['sessionId', 'routeId', 'checkpointId', 'progressPct', 'state', 'lastSeen'])",
        "sessionId": { ".validate": "newData.isString()" },
        "routeId": { ".validate": "newData.isString()" },
        "checkpointId": { ".validate": "newData.isString()" },
        "progressPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "state": { ".validate": "newData.val().matches(/^(idle|awaiting|active|paused|complete)$/)" },
        "lastSeen": { ".validate": "newData.val() === now" },
        "stepHesitationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "aacRequest": { ".validate": "newData.val().matches(/^(too_loud|need_help|show_me|break)$/)" },
        "wrongScanCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "overrides": {
      "$studentId": {
        ".indexOn": ["consumed"],
        ".read": "auth != null && (root.child('devices/' + auth.uid + '/studentId').val() === $studentId || root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true || root.child('supervisors/' + auth.uid + '/role').val() === 'admin')",
        "$id": {
          ".write": "auth != null && newData.exists() && (root.child('devices/' + auth.uid + '/studentId').val() === $studentId || root.child('supervisors/' + auth.uid + '/students/' + $studentId).val() === true)",
          ".validate": "newData.hasChildren(['command', 'source', 'issuedBy', 'timestamp', 'consumed'])",
          "command": { ".validate": "newData.val().matches(/^(skip|reset|pause|resume)$/)" },
          "source": { ".validate": "newData.val().matches(/^(voice|menu|dashboard)$/)" },
          "issuedBy": { ".validate": "newData.val() === auth.uid" },
          "timestamp": { ".validate": "(data.exists() && newData.val() === data.val()) || newData.val() === now" },
          "consumed": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
